# ============================================
# Scène RT : "Prairie alpine en plein jour"
# Grande prairie verte sous un ciel bleu éclatant,
# montagne enneigée en arrière-plan, arbres à
# feuillage rond, fleurs sauvages colorées.
# Contraste volontaire avec les scènes précédentes :
# lumière naturelle abondante, palette claire et
# ouverte au lieu d'un intérieur sombre ou d'un
# crépuscule.
# ============================================

# --- Ambiance générale ---
bg 0.55 0.78 0.95          # Ciel bleu vif de milieu de journée
A 0.45 0.45 0.4            # Ambiante forte, lumière diffuse du jour

# --- Éclairages ---
directional 0.2 -1.0 -0.3 1.0 0.98 0.92 1.0   # Soleil haut, quasi zénithal, très intense
L 10.0 12.0 6.0 1.0 0.95 0.8 0.3               # Léger point d'appoint doré

# --- Caméra ---
c 0.0 3.0 16.0 0.0 -0.15 -1.0 0.0 1.0 0.0 50.0

# --- Sol : prairie herbeuse ---
pl 0.0 -2.0 0.0 0.0 1.0 0.0
material 0.25 0.55 0.2 0.4 0.6 0.05 4.0 0.0

# --- Montagne enneigée à l'horizon (grande sphère semi-enterrée) ---
sp 0.0 -6.0 -30.0 12.0
material 0.75 0.75 0.8 0.5 0.4 0.1 8.0 0.0

# --- Cime enneigée (accent blanc au sommet) ---
sp 0.0 4.5 -30.0 3.0
material 0.95 0.95 0.98 0.6 0.3 0.2 16.0 0.05

# --- Arbre feuillu n°1 (tronc + houppier rond) ---
cy -5.0 -0.8 -3.0 0.0 1.0 0.0 0.3 1.6
material 0.4 0.25 0.12 0.3 0.5 0.05 4.0 0.0

sp -5.0 1.2 -3.0 1.3
material 0.3 0.65 0.2 0.3 0.6 0.1 8.0 0.0

# --- Arbre feuillu n°2 ---
cy 5.5 -0.9 -4.0 0.0 1.0 0.0 0.3 1.4
material 0.4 0.25 0.12 0.3 0.5 0.05 4.0 0.0

sp 5.5 0.8 -4.0 1.1
material 0.35 0.7 0.15 0.3 0.6 0.1 8.0 0.0

# --- Fleurs sauvages (petites sphères colorées au sol) ---
sp -2.0 -1.6 3.0 0.25
material 0.95 0.2 0.3 0.3 0.6 0.3 16.0 0.0     # Rouge

sp -1.0 -1.65 3.5 0.2
material 0.95 0.85 0.1 0.3 0.6 0.3 16.0 0.0    # Jaune

sp 0.5 -1.6 2.5 0.22
material 0.6 0.2 0.85 0.3 0.6 0.3 16.0 0.0     # Violette

sp 1.8 -1.65 4.0 0.2
material 0.95 0.5 0.15 0.3 0.6 0.3 16.0 0.0    # Orange

# --- Rocher au premier plan (échelle et contraste) ---
sp 2.5 -1.3 0.5 0.7
material 0.5 0.48 0.45 0.4 0.5 0.1 4.0 0.0
