# Direct light (T058b) : spot `headlight` pose sur la camera qui aveugle.
# Le spot part de l'oeil (`position` = camera) vers la scene (`target` = centre),
# cone 25 degres, intensite 3 : le devant de la sphere sature en blanc
# (diffus frontal + speculaire `V = -ray.dir` aligne, `Blinn-Phong`).
# Variante (a) du point ouvert O4 (spot face camera) : inversez `position` et
# `target` (spot dans la scene vers l'oeil) — le cone `isInSpotCone` supporte
# les deux sens sans recompiler (voir `SpotLight.hpp`).
scene {
    limits { width 320 height 240 samples 4 max_depth 4 }
    camera { position (0 1 4) target (0 0 0) fov 60 }
    background { color (0.02 0.02 0.05) }
    ambient { color (0.06 0.06 0.08) intensity 1.0 }
    lights {
        light spot "face" {
            position (0 1 4)
            target (0 0 0)
            angle 25
            color (1 1 1)
            intensity 3.0
        }
    }
    objects {
        object { type plane point (0 -1 0) normal (0 1 0)
            material { albedo (0.5 0.5 0.5) diffuse 0.8 ambient 0.05 }
        }
        object { type sphere center (0 0 0) radius 1
            material { albedo (0.8 0.2 0.2) diffuse 0.7 ambient 0.1
                specular 0.8 shininess 64 }
        }
    }
}
