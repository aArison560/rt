# scenes/fig_vi1.rt — scene obligatoire 1 (T080, figure VI.1 du sujet).
# Les 4 formes de base dans la meme image (plan + sphere + cylindre + cone ;
# ici 2 spheres pour prouver la coexistence T046), 2 spots (ombres porteuses,
# multi-spot T052), brillance Blinn-Phong (speculaire T053).
# Camera (0 2 6) -> (0 0 0) fov 50 : meme cadrage que `fig_vi1_base.rt` (T048)
# pour comparer (base = 2 ponctuelles, ici = 2 spots + speculaire).
# Toute directive existe dans `docs/FORMAT_SCENE.md` §5 (table `src/schema/`, R1).
# Ecarts assumes vs figure VI.1 du sujet (T080) :
# - 2 spheres (rouge à gauche, verte à droite) au lieu d'1 : prouve la
#   coexistence de plusieurs objets du meme type (exigence fiche §3.3).
# - Couleurs vives (rouge/vert/magenta/jaune) au lieu des tons du sujet :
#   chaque primitive est identifiable à l'oeil pour la demo.
# - 2 spots "key" (4 6 4, 45°, 1.5) + "fill" (-4 5 3, 40°, 0.8) : le sujet ne
#   fige ni positions ni intensites ; ce reglage donne ombres croisees +
#   point blanc speculaire visibles sur `docs/preuves/fig_vi1.png`.
# - Cylindre incline 45° autour de Z et cone en arriere-plan (0 1 -2,
#   angle 20) : montre translation + rotation (M4) dans la scene obligatoire.
# - Sol gris albedo 0.5 + fond (0.02 0.02 0.05) + ambiance (0.06 0.06 0.08) :
#   aucun pixel totalement noir (Ambiance light).
scene "fig_vi1" {
    limits {
        width 320
        height 240
        samples 4
        max_depth 4
        seed 0
    }
    camera {
        position (0 2 6)
        target (0 0 0)
        up (0 1 0)
        fov 50
    }
    background {
        color (0.02 0.02 0.05)
    }
    ambient {
        color (0.06 0.06 0.08)
        intensity 1.0
    }
    lights {
        light spot "key" {
            position (4 6 4)
            target (0 0 0)
            angle 45
            color (1 1 1)
            intensity 1.5
        }
        light spot "fill" {
            position (-4 5 3)
            target (0 0 0)
            angle 40
            color (0.9 0.9 1)
            intensity 0.8
        }
    }
    objects {
        object plane "sol" {
            point (0 -1 0)
            normal (0 1 0)
            material {
                albedo (0.5 0.5 0.5)
                diffuse 0.7
                specular 0.2
                shininess 16
            }
        }
        object sphere "rouge" {
            center (-2.2 0 0)
            radius 1
            material {
                albedo (0.9 0.1 0.1)
                diffuse 0.7
                specular 0.8
                shininess 64
            }
        }
        object sphere "verte" {
            center (2.2 0 0)
            radius 1
            material {
                albedo (0.1 0.9 0.1)
                diffuse 0.7
                specular 0.8
                shininess 64
            }
        }
        object cylinder "magenta" {
            center (0 0.5 0)
            radius 0.5
            transform {
                rotate axis z angle 45
            }
            material {
                albedo (0.9 0.1 0.8)
                diffuse 0.7
                specular 0.6
                shininess 32
            }
        }
        object cone "jaune" {
            center (0 1 -2)
            angle 20
            material {
                albedo (0.9 0.9 0.1)
                diffuse 0.7
                specular 0.6
                shininess 32
            }
        }
    }
}
