# scenes/opt_wave.rt — perturbation de normale par onde (T107).
# `pattern { type sine scale A frequency f }` : `A` = amplitude (0 = off),
# `f` = pulsation spatiale. Independant des couleurs (albedo inchange).
scene "wave" {
    limits {
        width 320
        height 240
        samples 2
        max_depth 2
        seed 15
    }
    camera {
        position (0 3 9)
        target (0 1 0)
        up (0 1 0)
        fov 55
    }
    background {
        color (0.02 0.02 0.05)
    }
    ambient {
        color (0.3 0.3 0.32)
        intensity 1.0
    }
    lights {
        light point "key" {
            position (4 6 4)
            color (1 1 1)
            intensity 1.2
        }
    }
    objects {
        object plane "sol" {
            point (0 0 0)
            normal (0 1 0)
            material {
                albedo (0.7 0.7 0.75)
                specular 0.8
                shininess 64
                pattern {
                    type sine
                    scale 0.4
                    frequency 3
                }
            }
        }
        object sphere "boule" {
            center (0 1.4 0)
            radius 1.4
            material {
                albedo (0.8 0.4 0.3)
                specular 0.8
                shininess 64
                pattern {
                    type sine
                    scale 0.4
                    frequency 3
                }
            }
        }
    }
}
