# scenes/fig_vi2.rt — scene obligatoire 2 (T081, "seul l'oeil deplace").
# Copie quasi identique de `fig_vi1.rt` : SEULE la directive `camera` differe
# (position (3.5 2.5 4.5) au lieu de (0 2 6), meme cible (0 0 0), meme up,
# meme fov 50). Tout le reste (limits, background, ambient, lights, objects)
# est identique ligne a ligne — verifie par `tests/integration/test_mandatory.cpp`
# qui echoue si autre chose que `camera` (ou le nom de scene / commentaires)
# differe. Toute directive existe dans `docs/FORMAT_SCENE.md` §5 (R1).
scene "fig_vi2" {
    limits {
        width 320
        height 240
        samples 4
        max_depth 4
        seed 0
    }
    camera {
        position (3.5 2.5 4.5)
        target (0 0 0)
        up (0 1 0)
        fov 50
    }
    background {
        color (0.02 0.02 0.05)
    }
    ambient {
        color (0.06 0.06 0.08)
        intensity 1.0
    }
    lights {
        light spot "key" {
            position (4 6 4)
            target (0 0 0)
            angle 45
            color (1 1 1)
            intensity 1.5
        }
        light spot "fill" {
            position (-4 5 3)
            target (0 0 0)
            angle 40
            color (0.9 0.9 1)
            intensity 0.8
        }
    }
    objects {
        object plane "sol" {
            point (0 -1 0)
            normal (0 1 0)
            material {
                albedo (0.5 0.5 0.5)
                diffuse 0.7
                specular 0.2
                shininess 16
            }
        }
        object sphere "rouge" {
            center (-2.2 0 0)
            radius 1
            material {
                albedo (0.9 0.1 0.1)
                diffuse 0.7
                specular 0.8
                shininess 64
            }
        }
        object sphere "verte" {
            center (2.2 0 0)
            radius 1
            material {
                albedo (0.1 0.9 0.1)
                diffuse 0.7
                specular 0.8
                shininess 64
            }
        }
        object cylinder "magenta" {
            center (0 0.5 0)
            radius 0.5
            transform {
                rotate axis z angle 45
            }
            material {
                albedo (0.9 0.1 0.8)
                diffuse 0.7
                specular 0.6
                shininess 32
            }
        }
        object cone "jaune" {
            center (0 1 -2)
            angle 20
            material {
                albedo (0.9 0.9 0.1)
                diffuse 0.7
                specular 0.6
                shininess 32
            }
        }
    }
}
