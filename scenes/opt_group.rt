# scenes/opt_group.rt — elements composes reutilisables (T101, *Composed elements*).
# Composition "verre" = cone + cylindre + sphere, definie une fois comme
# patron (3 objets, meme ordre, memes rayons) et instanciee 2 fois a des
# positions/orientations differentes via le `transform` parent du groupe.
# L'instanciation partage la definition logique (memes types/parametres,
# voir tests/unit/test_group.cpp) : le code d'intersection est partage
# (vtable T040, zero duplication) et les enfants `shared_ptr` permettent
# le partage physique d'une definition (test `shared_ptr`).
scene "group" {
    limits {
        width 320
        height 240
        samples 2
        max_depth 4
        seed 7
    }
    camera {
        position (0 3 10)
        target (0 1 0)
        up (0 1 0)
        fov 50
    }
    background {
        color (0.02 0.02 0.05)
    }
    ambient {
        color (0.06 0.06 0.08)
        intensity 1.0
    }
    lights {
        light point "key" {
            position (4 6 4)
            color (1 1 1)
            intensity 1.0
        }
    }
    objects {
        object plane "sol" {
            point (0 0 0)
            normal (0 1 0)
            material {
                albedo (0.5 0.5 0.5)
            }
        }
        group "verre_gauche" {
            transform {
                translate (-2.2 0 0)
            }
            object cone "corps" {
                angle 20
                material {
                    albedo (0.7 0.8 0.9)
                }
            }
            object cylinder "col" {
                center (0 1.5 0)
                material {
                    albedo (0.7 0.8 0.9)
                }
            }
            object sphere "bouchon" {
                center (0 2.6 0)
                radius 0.5
                material {
                    albedo (0.9 0.3 0.2)
                }
            }
        }
        group "verre_droite" {
            transform {
                translate (2.2 0 0)
            }
            object cone "corps" {
                angle 20
                material {
                    albedo (0.7 0.8 0.9)
                }
            }
            object cylinder "col" {
                center (0 1.5 0)
                material {
                    albedo (0.7 0.8 0.9)
                }
            }
            object sphere "bouchon" {
                center (0 2.6 0)
                radius 0.5
                material {
                    albedo (0.9 0.3 0.2)
                }
            }
        }
    }
}
