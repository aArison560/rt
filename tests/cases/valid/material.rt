# tests/cases/valid/material.rt — materiau complet (T027).
# Couvre : albedo/diffuse/specular/shininess/reflectivity/transparency+ior.
scene {
    limits {
        width 320
        height 240
        samples 2
    }
    camera {
        position (0 1 4)
        target (0 0 0)
        fov 60
    }
    lights {
        light {
            position (2 4 3)
            color (1 1 1)
            intensity 1.0
        }
    }
    objects {
        object {
            type sphere
            center (0 0 0)
            radius 1
            material {
                albedo (0.9 0.3 0.2)
                diffuse 0.7
                specular 0.8
                shininess 32
                reflectivity 0.2
                transparency 0.5
                ior 1.5
            }
        }
    }
}
