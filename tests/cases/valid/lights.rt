# tests/cases/valid/lights.rt — trois types de lumieres (T027).
# Couvre : point (position), directional (direction), spot (position+target).
scene {
    camera {
        position (0 2 6)
        target (0 0 0)
        fov 50
    }
    lights {
        light {
            type point
            position (3 5 2)
            color (1 1 1)
            intensity 0.8
            attenuation 1 0 0
            range 10
        }
        light {
            type directional
            direction (0 -1 -0.5)
            color (0.8 0.8 1)
            intensity 0.5
        }
        light {
            type spot
            position (0 5 0)
            target (0 0 0)
            angle 30
            color (1 1 1)
            intensity 0.6
        }
    }
    objects {
        object {
            type sphere
            center (0 0 0)
            radius 1
        }
    }
}
